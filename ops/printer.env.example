# Non-secret printer identity. LAN access code is read from Bambu Studio.
BAMBU_PRINTER_NAME=p1s
BAMBU_PRINTER_HOST=192.168.1.100
BAMBU_PRINTER_SERIAL=YOUR_PRINTER_SERIAL
# Override for a native installation or another Studio location:
# BAMBU_STUDIO_CONFIG=/path/to/BambuStudio.conf
# Job preparer that admits prints (absolute paths; see docs/print-admission.md).
# Without it the server runs but refuses every print.
# BAMBU_PREFLIGHT_COMMAND_JSON='["/usr/bin/node","/path/to/apps/assembly-guide/cad/preflight.mjs"]'
# BAMBU_PREFLIGHT_TIMEOUT_S=1800
