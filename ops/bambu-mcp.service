[Unit]
Description=Shared local Bambu MCP connection
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/bambu-mcp/printer.env
ExecStart=/usr/bin/python3 %h/.local/share/bambu-mcp/launch.py --http
WorkingDirectory=%h/.local/share/bambu-mcp
Restart=always
RestartSec=5
TimeoutStopSec=15
SuccessExitStatus=143
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
